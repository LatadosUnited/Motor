#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @MOTOR_RC_MAJOR@,@MOTOR_RC_MINOR@,@MOTOR_RC_PATCH@,0
PRODUCTVERSION @MOTOR_RC_MAJOR@,@MOTOR_RC_MINOR@,@MOTOR_RC_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Motor"
            VALUE "FileDescription", "@MOTOR_RC_DESCRIPTION@"
            VALUE "FileVersion", "@MOTOR_RC_VERSION@"
            VALUE "OriginalFilename", "@MOTOR_RC_FILENAME@"
            VALUE "ProductName", "Motor"
            VALUE "ProductVersion", "@MOTOR_RC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END

@MOTOR_RC_EXTRA@
